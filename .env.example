# Server Configuration
PORT=3000
NODE_ENV=development

# Credential Encryption Master Key (32-byte hex string for AES-256-GCM)
# In development, auto-generated if omitted
FABRIC_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Optional Obsidian Vault Path (defaults to C:\projects\orchestra-brain)
OBSIDIAN_VAULT_PATH=C:\projects\orchestra-brain

# Local Workspace Root
WORKSPACE_ROOT=x:\MyIDE\workspace
